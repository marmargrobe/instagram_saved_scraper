# Copy to .env and fill in. .env is never committed.

# Local Postgres (created with sqitch_mars)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mars
DB_USER=your-mac-username
DB_PASSWORD=

# Where data lives, outside the repo (see src/helper/paths.py)
DATA_DIR=~/Data/saved-instagram

# Only for the 2024 API scraper (src/data_scraper); leave empty otherwise
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
