# Data lives outside the repo, in DATA_DIR (see src/helper/paths.py). These rules are a second line
# of defence in case data files end up in the working copy anyway.

# Secrets and local settings
.env
.env.*
!.env.example
credentials.json
api_key.json
*.pem
*.key

# Data files (code, schemas and app assets are the only things committed)
*.csv
*.tsv
*.tsv.gz
*.zip
*.ipynb
*.sqlite
*.dump
output.txt
properties.txt
data/
media/
logs/
src/data_scraper_downloads/downloaded/
src/data_scraper_downloads/proxy/

# Local-only folders
deleted/

# Python
__pycache__/
.venv/
.venv_data_cleaner/
.venv_data_maps/

# Editors and OS
.vscode/
.idea/
.DS_Store

# Local tool settings (Claude Code launch config)
.claude/
