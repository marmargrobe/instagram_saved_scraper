# Use NVIDIA CUDA base image with Ubuntu 22.04
FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

# Set environment variable to prevent tzdata from prompting for input
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=America

# Install software-properties-common for add-apt-repository
RUN apt-get update && \
    apt-get install -y --no-install-recommends software-properties-common && \
    rm -rf /var/lib/apt/lists/*

# Add deadsnakes PPA for Python 3.12
RUN add-apt-repository ppa:deadsnakes/ppa && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    python3.12 \
    python3.12-venv \
    python3-pip \
    libpq-dev \
    gcc \
    tzdata && \
    rm -rf /var/lib/apt/lists/*

# Set Python 3.12 as the default python and pip version
RUN ln -s /usr/bin/python3.12 /usr/local/bin/python && \
    ln -s /usr/bin/pip3 /usr/local/bin/pip

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Set the working directory in the container
WORKDIR /app

# Copy the project files to the working directory
COPY src/ /app/src

# Copy the .env file
COPY .env /app/.env

# Install Python dependencies including GPU-enabled PyTorch
RUN python -m venv venv && \
    . /app/venv/bin/activate && \
    pip install --upgrade pip && \
    pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu118 && \
    pip install -r src/data_cleaner/requirements.txt

# Make sure the virtual environment is activated for future commands
ENV PATH="/app/venv/bin:$PATH"

# Specify the command to run your Python application
CMD ["python", "-m", "src.data_cleaner.data_categorization"]
